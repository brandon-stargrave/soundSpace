    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "express": "^5.1.0",
    "three": "^0.175.0",
